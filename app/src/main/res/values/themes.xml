<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.JustType" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/fgbg</item>
        <item name="colorPrimaryVariant">@color/status</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/darkbg</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/darkbg</item>
        <item name="colorSurface">@color/card_bg</item>
    </style>

    <!-- Settings Activity Theme with ActionBar -->
    <style name="Theme.JustType.Settings" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/card_bg</item>
        <item name="colorPrimaryVariant">@color/darkbg</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/darkbg</item>
        <item name="colorSurface">@color/card_bg</item>
    </style>

    <style name="Theme.JustType.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <!-- Radius of the outer bound of widgets to make the rounded corners -->
        <item name="appWidgetRadius">16dp</item>
        <item name="appWidgetInnerRadius">8dp</item>
    </style>

    <style name="Theme.JustType.AppWidgetContainer" parent="Theme.JustType.AppWidgetContainerParent">
        <item name="appWidgetPadding">16dp</item>
    </style>
</resources>